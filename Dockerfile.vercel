# Vercel construye esta imagen y la corre en Fluid.
# La app tiene que escuchar el puerto de la variable PORT.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache fontconfig ttf-dejavu
WORKDIR /app
COPY --from=build /src/target/AppBibliotecaWeb-0.0.1-SNAPSHOT.jar app.jar
ENV PORT=80
EXPOSE 80
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
